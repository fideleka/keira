+/* Set/acknowledge a level source; only instruction boundaries deliver it.
+** Do not touch the legacy pulse latch or cached execution registers here. */
+void nes6502_setirq(uint8 source, bool asserted)
+{
+   if (asserted)
+      cpu.irq_sources |= source;
+   else
+      cpu.irq_sources &= (uint8)~source;
 }
 
